ent; border: none;\">\n             <td colspan=\"5\" style=\"border: none;\"></td>\n         </tr>\n      <tr  style=\"width: 100%\">\n        <td class=\"center\" style=\"width: 8%\"> <b>Sr. # </b></td>\n        <td  style=\"width: 66%\"><b>Equipment Detail </b></td>\n        <td class=\"center\" style=\"width: 4%\"> <b>Qty </b></td>\n        <td  style=\"width: 14%\" class=\"center space\"> <b>Unit Price </b></td>\n        <td class=\"center space\" style=\"width: 8%\"> <b>Total Price </b></td>\n      </tr>\n      <tr  style=\"width: 100%\">\n        <td class=\"dot\" style=\"width: 8%; padding: 0px !important;\">1)</td>\n        <td style=\"width: 68%; padding: 5px !important\">\n         <strong> HPLC SYSTEM CALIBRATION <br> SCOPE <br></strong> FLOW RATE(VOLUEM) <br> OVEN TEMPERATURE\n        </td>\n        <td class=\"t-center\" style=\"width: 4%\">4</td>\n        <td class=\"t-down\" style=\"width: 12%;padding: 0px !important;\">7500</td>\n        <td class=\"center\" style=\"width: 8%;padding: 0px !important;\">30000</td>\n      </tr>\n      <tr  style=\"width: 100%\">\n        <td class=\"dot\" style=\"width: 8%; padding: 0px !important;\">2)</td>\n        <td style=\"width: 68%; padding: 5px !important\"><strong> DISSOLUTION APPARATUS <br>SCOPE <br></strong> TEMPERATUER <br> RPM <br> TIME</td>\n        <td class=\"t-center\" style=\"width: 4%\">1</td>\n        <td class=\"t-down\" style=\"width: 12% ;  padding: 0px !important;\">4500</td>\n        <td class=\"center\" style=\"width: 8%; padding: 0px !important;\">4500</td>\n      </tr>\n        <tr>\n            <tr style=\"height: 30px; background: transparent; border: none;\">\n             <td colspan=\"5\" style=\"border: none;\"></td>\n         </tr>\n      <tr>\n        <td colspan=\"4\" class=\"left-cell t-right\">Total:</td>\n        <td class=\"left-cell\">34500</td>\n      </tr>\n      <tr>\n        <td colspan=\"4\" class=\"left-cell t-right\">16% PRA SERVICES TAX:</td>\n        <td class=\"left-cell\">5520</td>\n      </tr>\n      <tr>\n        <td colspan=\"4\" class=\"left-cell t-right\">TA/DA CHARGES:</td>\n        <td class=\"left-cell\">3000</td>\n      </tr>\n      <tr>\n        <td colspan=\"4\" class=\"left-cell t-right\">NET AMOUNT:</td>\n        <td class=\"left-cell\">43020</td>\n      </tr>\n      <tr>\n        <td class=\"heading\" colspan=\"5\"><p style=\"margin-left:20px; font-weight: 600;\">RUPEES: FORTY THREE THOUSAND TWENTY ONLY. </p></td>\n      </tr>\n              <tr>\n            <tr style=\"height: 25px; background: transparent; border: none;\">\n             <td colspan=\"5\" style=\"border: none;\"></td>\n         </tr>\n\n      <tr>\n        <td class=\"heading\" colspan=\"5\"><strong>3- TERMS AND CONDITIONS:</strong></td>\n      </tr>\n               <tr>\n            <tr style=\"height: 25px; background: transparent; border: none;\">\n             <td colspan=\"5\" style=\"border: none;\"></td>\n         </tr>\n      \n      \n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Quoted prices are only the Calibration charges.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Please Provide Complete Calibration requirement of equipment under Calibration i.e Cal. Range, Parameters, Specification, ID Code etc. (Changing requirements will vary the Calibration cost).</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Please provide process control limits/tolerance limits for statement of conformity rule. (if requested)</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 <span class=\"highlight\">Links 2000</span> will adopt the calibration method requested by the customer only if it is feasible and up-to-dated. In case we are unable to adopt the requested calibration method, we will inform the customer well in advance.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Witness can be done upon request.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Please update about <span class=\"highlight\">Cal. Due date</span> before Calibration of Equipment.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Line-item charges shall be applicable in case of acceptance of total quote. In case of any variation in quoted services, <span class=\"highlight\">Links 2000</span> Reserve the right to change the offered charges.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Please confirm quotation through email / Letter <span class=\"highlight\">(Acceptance Document/Agreement)</span>.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Turnaround time for the quoted scope of work shall be maximum 5 to 7 working day. May delay due to any unforeseen activities.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Most of the Instrument Calibration shall be performed at your Lab/site. Some item calibration will be performed at our lab.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Calibration tag and Calibration certificates shall be provided to the Customer.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 <span class=\"highlight\">Links 2000</span> shall remain committed to impartial.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 <span class=\"highlight\">Links 2000</span> May release confidential information if required by Law or authorities. And will use the name and logo as on its marketing brochure.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 <span class=\"highlight\">Links 2000</span> is committed to inform to the customer if any deviation in contract.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 If a contract amended after work has commenced, the contract review shall be repeated and any amended shall be communicated to all effected personnel.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" class=\"terms-cell bullet-point\">\u2022 Our primary source shall be traceable. (Metrological Traceability).</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Food and accommodation will be provided by customer.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Instrument transportation is in the Customer's scope.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 In case, an equipment is found faulty during Calibration & Inspection process, fee will be charged <span class=\"highlight\">(Kindly arrange operative equipment only)</span>.</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 For further any query or complaint you may contact on email: info@links2000.com.pk</td>\n            </tr>\n            <tr>\n                <td colspan=\"5\" style=\"padding:0px !important;\" class=\"terms-cell bullet-point\">\u2022 Payment terms shall be 100% Advanced.</td>\n            </tr>\n                    <tr>\n            <tr style=\"height: 20px; background: transparent; border: none;\">\n             <td colspan=\"5\" style=\"border: none;\"></td>\n         </tr>\n     \n               <tr>\n           <td style=\"border: none\" colspan=\"5\">\n        <strong> 4- &nbsp;&nbsp; <span style=\"text-decoration: underline; text-decoration-thickness: 2px;\">\n        Bank Detail:\n            </span>\n            </strong>\n               </td>\n          </tr>\n                        <tr>\n            <tr style=\"height: 20px; background: transparent; border: none;\">\n             <td colspan=\"5\" style=\"border: none;\"></td>\n         </tr>\n\n          <tr>\n        <td colspan=\"1\" style=\"background-color:#d9d9d9\"><b>Bank Name: </b></td>\n        <td colspan=\"4\"><b>FAYSAL BANK</b></td>\n        <!--<td></td>-->\n      </tr>\n      <tr>\n        <td colspan=\"1\" style=\"background-color:#d9d9d9\" > <b>Account Title: </b></td>\n        <td colspan=\"4\"><b>LINKS 2000</b></td>\n      </tr>\n      <tr>\n        <td colspan=\"1\" style=\"background-color:#d9d9d9\"><b>Account #:</b></td>\n        <td colspan=\"4\"><b>3040 301000002465</b></td>\n      </tr>\n      <tr>\n        <td colspan=\"1\" style=\"background-color:#d9d9d9\" ><b>IBAN: </b></td>\n        <td colspan=\"4\"><b>PK91FAYS3040301000002465</b></td>\n      </tr>\n      \n      <tr>\n        <td colspan=\"1\" style=\"background-color:#d9d9d9\" ><b>SWIFT CODE: </b></td>\n